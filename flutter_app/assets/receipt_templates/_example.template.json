{
  "id": "example_supplier",
  "name": "Пример: ООО Поставщик (переименуйте файл без _)",
  "description": "Скопируйте в my_supplier.json, подставьте фразы из реального чека и mappings.",
  "detect": {
    "min_score": 3,
    "any_contains": [
      "ИНН 7700000000",
      "ООО ПРИМЕР ПОСТАВЩИК",
      "Счёт на оплату"
    ],
    "regex": []
  },
  "supplier": {
    "line_index": 0,
    "from_regex": "^(ООО|ИП)\\s+.+",
    "fixed_name": null
  },
  "items": {
    "start_line_index": 5
  },
  "skip_lines": {
    "contains": ["итого", "всего", "ндс", "банк", "получатель", "плательщик"],
    "regex": ["^\\s*\\d{1,2}\\.\\d{2}\\.\\d{4}"]
  },
  "line_patterns": [
    {
      "comment": "Наименование ... кол-во ... цена ... сумма",
      "regex": "^(?P<name>.+?)\\s+(?P<qty>[\\d.,]+)\\s+(?P<price>[\\d\\s.,]+)\\s+(?P<sum>[\\d\\s.,]+)\\s*$"
    },
    {
      "comment": "Наименование — цена в конце строки",
      "regex": "^(?P<name>.+?)\\s+[-–]?\\s*(?P<price>[\\d\\s.,]+)\\s*(?:руб|₽)?\\s*$"
    }
  ],
  "fallback_trailing_price": true,
  "mappings": [
    {
      "match_contains": ["байкал", "baikal"],
      "item_key": "armstrong_baikal",
      "product_name": "Плита Армстронг Байкал"
    },
    {
      "match_contains": ["плита", "armstrong", "кассет"],
      "item_key": "armstrong_tile",
      "product_name": "Плита Армстронг"
    },
    {
      "match_regex": ["подвес.*0[,.]5", "подвес\\s*500"],
      "item_key": "susp_05",
      "product_name": "Подвес 0,5 м"
    },
    {
      "match_contains": ["направляющ", "3,6", "3600", "3.6"],
      "item_key": "guide_3600",
      "product_name": "Направляющая 3600"
    },
    {
      "match_contains": ["профиль", "папа"],
      "item_key": "profile_papa_50",
      "product_name": "Профиль Папа 50×50"
    },
    {
      "match_contains": ["уголок"],
      "item_key": "corner",
      "product_name": "Уголок 3 м"
    }
  ]
}
